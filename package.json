{
  "name": "copilot-plus",
  "displayName": "Copilot+",
  "description": "Real-time GitHub Copilot quota display, session cost tracking, and agent scope explorer",
  "version": "0.1.11",
  "publisher": "juninmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juninmd/copilot-plus"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "quota",
    "requests",
    "agents",
    "github"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotPlus.turbo",
        "title": "Enable Turbo Mode",
        "category": "Copilot+",
        "icon": "$(zap)"
      },
      {
        "command": "copilotPlus.refresh",
        "title": "Refresh Quota",
        "category": "Copilot+",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotPlus.openAgentExplorer",
        "title": "Open Agent Explorer",
        "category": "Copilot+",
        "icon": "$(extensions)"
      },
      {
        "command": "copilotPlus.diagnose",
        "title": "Diagnose Quota Connection",
        "category": "Copilot+",
        "icon": "$(bug)"
      },
      {
        "command": "copilotPlus.showHistory",
        "title": "Show Usage History",
        "category": "Copilot+",
        "icon": "$(history)"
      },
      {
        "command": "copilotPlus.auditContext",
        "title": "Audit Copilot Context & Instructions",
        "category": "Copilot+",
        "icon": "$(dashboard)"
      },
      {
        "command": "copilotPlus.generateInstructions",
        "title": "Generate Workspace Copilot Instructions",
        "category": "Copilot+",
        "icon": "$(file-text)"
      },
      {
        "command": "copilotPlus.createPromptTemplate",
        "title": "Create Custom Prompt Template",
        "category": "Copilot+",
        "icon": "$(add)"
      },
      {
        "command": "copilotPlus.runPromptTemplate",
        "title": "Run Prompt Template with Context",
        "category": "Copilot+",
        "icon": "$(play)"
      },
      {
        "command": "copilotPlus.recommendModel",
        "title": "Recommend Optimal Model",
        "category": "Copilot+",
        "icon": "$(lightbulb)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotPlus",
          "title": "Copilot+",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "copilotPlus": [
        {
          "id": "copilotPlus.agents",
          "name": "Agent Explorer"
        },
        {
          "id": "copilotPlus.models",
          "name": "Available Models"
        },
        {
          "id": "copilotPlus.tools",
          "name": "Available Tools"
        },
        {
          "id": "copilotPlus.mcps",
          "name": "MCP Servers"
        },
        {
          "id": "copilotPlus.prompts",
          "name": "Instructions & Prompts"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotPlus.turbo",
          "when": "view == copilotPlus.agents || view == copilotPlus.models || view == copilotPlus.tools || view == copilotPlus.mcps || view == copilotPlus.prompts",
          "group": "navigation"
        },
        {
          "command": "copilotPlus.refresh",
          "when": "view == copilotPlus.agents || view == copilotPlus.models || view == copilotPlus.tools || view == copilotPlus.mcps || view == copilotPlus.prompts",
          "group": "navigation"
        },
        {
          "command": "copilotPlus.recommendModel",
          "when": "view == copilotPlus.models",
          "group": "navigation"
        },
        {
          "command": "copilotPlus.auditContext",
          "when": "view == copilotPlus.prompts",
          "group": "navigation"
        },
        {
          "command": "copilotPlus.generateInstructions",
          "when": "view == copilotPlus.prompts",
          "group": "navigation"
        },
        {
          "command": "copilotPlus.diagnose",
          "when": "view == copilotPlus.agents",
          "group": "navigation"
        },
        {
          "command": "copilotPlus.showHistory",
          "when": "view == copilotPlus.agents || view == copilotPlus.models || view == copilotPlus.tools || view == copilotPlus.mcps || view == copilotPlus.prompts",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Copilot+",
      "properties": {
        "copilotPlus.quotaTotal": {
          "type": "number",
          "default": 300,
          "description": "Your total monthly premium request quota (default 300 for Individual plan)"
        },
        "copilotPlus.refreshIntervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 60,
          "description": "How often to refresh quota from GitHub (minutes)"
        },
        "copilotPlus.autoTurbo": {
          "type": "boolean",
          "default": false,
          "description": "Automatically enable experimental Copilot features on startup"
        }
      }
    },
    "languageModelTools": [
      {
        "id": "copilotPlus_getQuota",
        "name": "get_copilot_quota",
        "displayName": "Copilot Quota Info",
        "modelDescription": "Gets live remaining GitHub Copilot request quota and session usage statistics.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "id": "copilotPlus_recommendModel",
        "name": "recommend_copilot_model",
        "displayName": "Recommend Copilot Model",
        "modelDescription": "Recommends the most cost-effective and suitable LLM model for a specific development task.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "taskDescription": {
              "type": "string",
              "description": "Description of the task to perform (e.g. fast refactoring, complex architecture, test generation)."
            }
          }
        }
      },
      {
        "id": "copilotPlus_auditContext",
        "name": "audit_copilot_context",
        "displayName": "Audit Copilot Context & Instructions",
        "modelDescription": "Audits workspace .github/copilot-instructions.md, prompt templates, active file token load, and context health.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "copilotPlus.participant",
        "name": "copilotPlus",
        "description": "Copilot+ Assistant for quota stats, model selection, instructions, and turbo settings",
        "commands": [
          {
            "name": "quota",
            "description": "Show current Copilot request quota and session usage"
          },
          {
            "name": "recommend",
            "description": "Recommend optimal LLM model for a task"
          },
          {
            "name": "turbo",
            "description": "Enable experimental Copilot features"
          },
          {
            "name": "audit",
            "description": "Audit workspace Copilot instructions, prompt templates, and token budget efficiency"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "pnpm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run check-types && node esbuild.js --production",
    "vscode:prepublish": "pnpm run package",
    "lint": "eslint src --ext ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.6.0"
}
