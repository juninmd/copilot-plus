{
  "sessions.layout.singlePaneDetailPanel": true,
  "workbench.editor.showTabs": "single",
  "sessions.chatTimeline.display": "ruler",
  "workbench.editorAssociations": {
    "*.html": "workbench.editor.browser"
  },
  "chat.stickyScroll.enabled": true,
  "chat.experimental.stickyScroll.enabled": true,
  "chat.experimental.renderMarkdownImmediately": true,
  "workbench.browser.autoReloadOnFileChange": true,
  "chat.agentHost.allowSignedOutWhenUsable": true,
  "chat.agentSessions.showExternal": "recent",
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter": "left"
  },
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "chat.agentHost.copilotAgent.multiRootEnabled": true,
  "chat.agentHost.claudeAgent.multiRootEnabled": true,
  "chat.notifyWindowOnConfirmation": true,
  "chat.notifyWindowOnResponseReceived": true,
  "chat.agentMerge.enabled": true,
  "workbench.experimental.modernUI": true,
  "window.density.layout": "compact",
  "chat.agentSessions.preferredDarkBackgroundImage": "codicons",
  "chat.agentSessions.preferredLightBackgroundImage": "codicons",
  "chat.agentSessions.backgroundImageLayout": "repeat"
}
